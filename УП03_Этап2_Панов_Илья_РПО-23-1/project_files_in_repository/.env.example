# Пример переменных окружения проекта LandMark (Wanderlog).
# Скопируйте в backend/.env и при необходимости измените значения.
# Все переменные имеют безопасные значения по умолчанию (см. docker-compose.yml),
# поэтому для локального запуска файл .env не обязателен.
# Настоящие пароли/ключи/токены в репозиторий не коммитятся.

# Безопасность / межсервисное взаимодействие
AUTH_PEPPER=dev-pepper-change-me-32-bytes-min!
INTERNAL_API_KEY=dev-internal-key-change-me
CORS_ORIGINS=*

# Демо-аккаунт администратора (создаётся auth-сервисом при старте)
ADMIN_BOOTSTRAP_EMAIL=admin@apple.com
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123456

# Наблюдаемость (OpenTelemetry). Пусто — экспорт трейсов отключён.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Уведомления: путь к Firebase service-account JSON (пусто — push отключён)
FCM_SERVICE_ACCOUNT_PATH=

# Пароль администратора Grafana (http://localhost:3000, логин admin)
GRAFANA_PASSWORD=admin

# Адрес backend для мобильного клиента (через --dart-define при сборке Flutter)
# Android-эмулятор: http://10.0.2.2:8080, прочее: http://localhost:8080
API_BASE_URL=http://localhost:8080
