# =============================================================================
#  LandMark (Wanderlog) — пример файла окружения для backend
#  Скопируйте этот файл в backend/.env и при необходимости измените значения:
#      cp .env.example backend/.env
#  ВНИМАНИЕ: настоящие пароли, ключи и токены в репозиторий не коммитятся.
#  Все переменные имеют безопасные значения по умолчанию (см. docker-compose.yml),
#  поэтому для локального запуска файл .env не обязателен.
# =============================================================================

# --- Безопасность / межсервисное взаимодействие --------------------------------
# Соль приложения для хеширования паролей (Argon2id). Минимум 32 байта.
# В реальном проекте сгенерируйте случайное значение и храните в секретах.
AUTH_PEPPER=dev-pepper-change-me-32-bytes-min!

# Ключ для внутренних (service-to-service) вызовов между микросервисами.
INTERNAL_API_KEY=dev-internal-key-change-me

# Разрешённые источники CORS для API Gateway ("*" — только для разработки).
CORS_ORIGINS=*

# --- Демо-аккаунт администратора (идемпотентно создаётся при старте auth) -------
# Используется для входа в админ-раздел приложения. В проде — сменить!
ADMIN_BOOTSTRAP_EMAIL=admin@apple.com
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123456

# --- Наблюдаемость (OpenTelemetry) ---------------------------------------------
# Адрес OTLP-коллектора. Оставьте пустым, чтобы отключить экспорт трейсов.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Уведомления ---------------------------------------------------------------
# Путь к service-account JSON для Firebase Cloud Messaging (push).
# Пусто — push отключён, письма уходят в Mailpit (http://localhost:8025).
FCM_SERVICE_ACCOUNT_PATH=

# --- Мониторинг ----------------------------------------------------------------
# Пароль администратора Grafana (http://localhost:3000, логин admin).
GRAFANA_PASSWORD=admin

# =============================================================================
#  Клиент Flutter (передаётся не через .env, а через --dart-define при сборке):
#    flutter run --dart-define=API_BASE_URL=http://localhost:8080
#  По умолчанию: Android-эмулятор -> http://10.0.2.2:8080, иначе http://localhost:8080
# =============================================================================
