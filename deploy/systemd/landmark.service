# Пример systemd-юнита для автозапуска LandMark на VPS/Linux.
# Кладётся в /etc/systemd/system/landmark.service, затем:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now landmark

[Unit]
Description=LandMark (Wanderlog) production/demo stand
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/landmark
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
ExecStop=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml down
Restart=no

[Install]
WantedBy=multi-user.target
