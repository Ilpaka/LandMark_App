        <mxCell id="title_main" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;" value="&lt;div style=&quot;font-size:28px;font-weight:700;font-family:Arial,Helvetica,sans-serif;color:#0F172A;&quot;&gt;Схема декомпозиции предметной области&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-family:Arial,Helvetica,sans-serif;color:#334155;margin-top:8px;&quot;&gt;Мобильное приложение для ведения журнала путешественника с картой достопримечательностей&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1600" x="150" y="20" as="geometry" />
