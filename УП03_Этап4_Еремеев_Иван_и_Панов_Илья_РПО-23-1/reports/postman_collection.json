{
  "info": {
    "name": "LandMark API - stage 4 QA",
    "description": "Success + error scenarios for the LandMark API Gateway (demo stand). Set {{base}} = http://localhost:8080. Run register -> verify -> login to populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:8080" },
    { "key": "email", "value": "qa.user@example.com" },
    { "key": "password", "value": "QaPass1234567" },
    { "key": "verification_id", "value": "" },
    { "key": "dev_code", "value": "" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health (200)",
      "request": { "method": "GET", "url": "{{base}}/healthz" }
    },
    {
      "name": "List places - public (200)",
      "request": { "method": "GET", "url": "{{base}}/v1/places" }
    },
    {
      "name": "Register (200)",
      "event": [
        { "listen": "test", "script": { "exec": [
          "var j = pm.response.json();",
          "if (j.verification_id) pm.collectionVariables.set('verification_id', j.verification_id);",
          "if (j.dev_code) pm.collectionVariables.set('dev_code', j.dev_code);",
          "pm.test('status 200', function(){ pm.response.to.have.status(200); });"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base}}/v1/auth/register",
        "body": { "mode": "raw", "raw": "{\"name\":\"QA User\",\"email\":\"{{email}}\",\"password\":\"{{password}}\"}" }
      }
    },
    {
      "name": "Verify email (200)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base}}/v1/auth/verify-email",
        "body": { "mode": "raw", "raw": "{\"verification_id\":\"{{verification_id}}\",\"code\":\"{{dev_code}}\"}" }
      }
    },
    {
      "name": "Login (200) -> token",
      "event": [
        { "listen": "test", "script": { "exec": [
          "var j = pm.response.json();",
          "if (j.access_token) pm.collectionVariables.set('token', j.access_token);",
          "pm.test('has token', function(){ pm.expect(j.access_token).to.be.a('string'); });"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base}}/v1/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}" }
      }
    },
    {
      "name": "Profile me - with token (200)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{base}}/v1/profile/me"
      }
    },
    {
      "name": "Create trip - with token (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{base}}/v1/trips",
        "body": { "mode": "raw", "raw": "{\"title\":\"QA trip from Postman\"}" }
      }
    },
    {
      "name": "Login wrong password (401)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base}}/v1/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"WrongPass99999\"}" }
      }
    },
    {
      "name": "Register invalid email (400)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base}}/v1/auth/register",
        "body": { "mode": "raw", "raw": "{\"name\":\"x\",\"email\":\"not-an-email\",\"password\":\"{{password}}\"}" }
      }
    },
    {
      "name": "Profile without token (401)",
      "request": { "method": "GET", "url": "{{base}}/v1/profile" }
    },
    {
      "name": "Place not found (404)",
      "request": { "method": "GET", "url": "{{base}}/v1/places/00000000-0000-0000-0000-000000000000" }
    }
  ]
}
