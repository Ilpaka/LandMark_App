# ===========================================================================
# Пример переменных для DEMO-стенда проекта LandMark (Wanderlog).
#
# Используется для локального демонстрационного стенда (вариант C —
# локальный demo-стенд через Docker). Значения подобраны так, чтобы стенд
# поднимался без дополнительной настройки и его можно было сразу проверить.
#
# Скопируйте в .env.production и запустите:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
# ===========================================================================

# --- Режим приложения ------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# --- Секреты (demo-значения, не для реального продакшена) -------------------
AUTH_PEPPER=demo-pepper-32-bytes-min-1234567890ab
INTERNAL_API_KEY=demo-internal-key

# --- Demo-администратор (используется для входа при проверке) ---------------
ADMIN_BOOTSTRAP_EMAIL=admin@apple.com
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123456

# --- Пароль администратора Grafana -----------------------------------------
GRAFANA_PASSWORD=admin

# --- Для локального демо-стенда допустим "*", чтобы открыть с любого адреса -
CORS_ORIGINS=*

# --- Наблюдаемость / push отключены на демо-стенде -------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
FCM_SERVICE_ACCOUNT_PATH=

# --- Базовый адрес backend для локального клиента --------------------------
# Android-эмулятор: http://10.0.2.2:8080, прочее: http://localhost:8080
API_BASE_URL=http://localhost:8080
