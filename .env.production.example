# ===========================================================================
# Пример PRODUCTION-переменных проекта LandMark (Wanderlog).
#
# Скопируйте в .env.production и подставьте РЕАЛЬНЫЕ секреты.
# Файл .env.production в репозиторий НЕ коммитится (см. .gitignore).
#
# Запуск:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
# ===========================================================================

# --- Режим приложения ------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# --- Секреты межсервисного взаимодействия (ОБЯЗАТЕЛЬНО заменить) ------------
# AUTH_PEPPER должен быть случайной строкой не короче 32 байт.
AUTH_PEPPER=change_me_random_secret_min_32_bytes
INTERNAL_API_KEY=change_me_internal_api_key

# --- Стартовый администратор (создаётся auth-сервисом при первом запуске) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_strong_admin_password

# --- Пароль администратора Grafana (http://SERVER:3000, логин admin) --------
GRAFANA_PASSWORD=change_me_grafana_password

# --- CORS: домены фронтенда. В production НЕ используйте "*" ----------------
CORS_ORIGINS=https://example.com

# --- Наблюдаемость (OpenTelemetry). Пусто — экспорт трейсов отключён --------
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Push-уведомления: путь к Firebase service-account JSON (пусто — off) ---
FCM_SERVICE_ACCOUNT_PATH=

# --- Базовый адрес backend для сборки мобильного/web-клиента ---------------
API_BASE_URL=https://api.example.com
